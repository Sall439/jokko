# -----------------------------------------------------------------------------
# Variables d'environnement JokkoDentiste
# Copier ce fichier en `.env` puis adapter les valeurs.
# Toute variable préfixée EXPO_PUBLIC_ est exposée au bundle : n'y mettre
# aucun secret.
# -----------------------------------------------------------------------------

# URL de l'API REST JokkoDentiste (Node/Express + PostgreSQL + JWT).
# Ignorée tant que les services tournent sur les mocks.
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Bascule mock / API réelle. `true` = les services `*.service.mock.ts` sont
# utilisés, `false` = les services `*.service.api.ts` (Phase 7).
# Passer à `false` ne doit nécessiter aucune modification de composant ni d'écran.
EXPO_PUBLIC_USE_MOCKS=true