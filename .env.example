# ---------------------------------------------------------------- Application
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données (PostgreSQL uniquement — l'extension `btree_gist` est requise
# pour la contrainte d'exclusion anti-double-réservation).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jokkodentiste

# Préfixe secret de l'interface d'administration.
ADMIN_URL=admin/

# CORS / CSRF (front-end sur un autre port : les cookies exigent des origines
# explicites, d'où `CORS_ALLOW_CREDENTIALS=True` côté réglages).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------ Authentification
# `True` en production (HTTPS) : le cookie JWT n'est alors envoyé qu'en TLS.
JWT_AUTH_SECURE=False

# ------------------------------------------------------- Fuseau horaire métier
# Les créneaux sont exprimés dans ce fuseau ; le stockage se fait en UTC.
BUSINESS_TIME_ZONE=Africa/Dakar

# ------------------------------------------------------- Règles de rendez-vous
# Délai minimal avant le rendez-vous pour qu'un patient puisse encore annuler.
APPOINTMENT_CANCELLATION_WINDOW_HOURS=24
# Granularité du calcul des créneaux libres, en minutes.
APPOINTMENT_SLOT_GRANULARITY_MINUTES=30
# Horizon de réservation : au-delà, aucun créneau n'est proposé.
APPOINTMENT_BOOKING_HORIZON_DAYS=90
# Délai minimum entre l'instant présent et le début du rendez-vous.
APPOINTMENT_MIN_LEAD_MINUTES=60

# ------------------------------------------------------------- Notifications
# Émettrice des notifications déclenchées par les signaux (création,
# confirmation, annulation, absence, rappels).
NOTIFICATIONS_ENABLED=True
# En développement, `False` fait basculer le canal SMS sur l'email ; passer à
# `True` uniquement avec une passerelle SMS configurée.
NOTIFICATIONS_SMS_ENABLED=False
# Réservé à la production : dispatch asynchrone (Celery) si disponible.
# `True` sans Celery installé laisse les notifications en statut `pending`.
NOTIFICATIONS_ASYNC=False

# ------------------------------------------------------------------ Signature
# Les notifications sont renvoyées par le service de l'app `notifications` :
# `EMAIL_BACKEND` est surchargé par module (`base.py`) pour l'email console.
# SMTP réel : définir EMAIL_HOST / EMAIL_PORT / EMAIL_HOST_USER /
# EMAIL_HOST_PASSWORD dans `config/settings/prod.py`.
